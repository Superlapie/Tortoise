<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Tortoise.Broker\Tortoise.Broker.csproj" />
    <ProjectReference Include="..\..\src\Tortoise.Contracts\Tortoise.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Tortoise.Core\Tortoise.Core.csproj" />
    <ProjectReference Include="..\Tortoise.BrokerPipeProbe\Tortoise.BrokerPipeProbe.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <ProjectReference Include="..\Tortoise.MutationLockProbe\Tortoise.MutationLockProbe.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <ProjectReference Include="..\..\src\Tortoise.LabBroker\Tortoise.LabBroker.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <ProjectReference Include="..\..\src\Tortoise.Security\Tortoise.Security.csproj" />
  </ItemGroup>

  <Target Name="CopyLabBrokerForTests" AfterTargets="Build">
    <ItemGroup>
      <LabBrokerFiles Include="..\..\src\Tortoise.LabBroker\bin\$(Configuration)\$(TargetFramework)\tortoise-lab-broker.*" />
    </ItemGroup>
    <Copy SourceFiles="@(LabBrokerFiles)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyBrokerProbesForTests" AfterTargets="Build">
    <ItemGroup>
      <BrokerPipeProbeFiles Include="..\Tortoise.BrokerPipeProbe\bin\$(Configuration)\$(TargetFramework)\tortoise-broker-pipe-probe.*" />
      <MutationLockProbeFiles Include="..\Tortoise.MutationLockProbe\bin\$(Configuration)\$(TargetFramework)\tortoise-mutation-lock-probe.*" />
    </ItemGroup>
    <Copy SourceFiles="@(BrokerPipeProbeFiles)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(MutationLockProbeFiles)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
