<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>tortoise-lab</AssemblyName>
    <DefineConstants>$(DefineConstants);TORTOISE_LAB</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tortoise.LabBroker\Tortoise.LabBroker.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <ProjectReference Include="..\Tortoise.Broker\Tortoise.Broker.csproj" />
    <ProjectReference Include="..\Tortoise.Contracts\Tortoise.Contracts.csproj" />
    <ProjectReference Include="..\Tortoise.Core\Tortoise.Core.csproj" />
    <ProjectReference Include="..\Tortoise.Persistence\Tortoise.Persistence.csproj" />
    <ProjectReference Include="..\Tortoise.Security\Tortoise.Security.csproj" />
    <ProjectReference Include="..\Tortoise.Windows\Tortoise.Windows.csproj" />
    <ProjectReference Include="..\Tortoise.WindowsUpdate\Tortoise.WindowsUpdate.csproj" />
  </ItemGroup>

  <Target Name="CopyLabBroker" AfterTargets="Build">
    <ItemGroup>
      <LabBrokerFiles Include="..\Tortoise.LabBroker\bin\$(Configuration)\$(TargetFramework)\tortoise-lab-broker.*" />
    </ItemGroup>
    <Copy SourceFiles="@(LabBrokerFiles)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

</Project>
