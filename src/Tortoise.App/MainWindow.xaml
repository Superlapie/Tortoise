<Window x:Class="Tortoise.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Tortoise.App.ViewModels"
        xmlns:views="clr-namespace:Tortoise.App.Views"
        Title="Tortoise"
        Height="720"
        Width="1180"
        MinHeight="560"
        MinWidth="900">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:OverviewViewModel}">
            <views:OverviewPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DevicesViewModel}">
            <views:DevicesPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UpdatesViewModel}">
            <views:UpdatesPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SafetyViewModel}">
            <views:SafetyPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
            <views:HistoryPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AboutViewModel}">
            <views:AboutPage />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="16">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,24">
                    <TextBlock Text="Tortoise" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="Transparent Windows driver management."
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               Margin="0,8,0,0" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding NavigationItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Title}"
                                    Command="{Binding NavigateCommand}"
                                    HorizontalContentAlignment="Left"
                                    Margin="0,0,0,8"
                                    Padding="12,10" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Padding="24,20"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button Content="Scan Again"
                                Style="{StaticResource AccentButtonStyle}"
                                Command="{Binding ScanAgainCommand}" />
                    </StackPanel>
                    <TextBlock Text="Read-only alpha — system mutation is disabled."
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedForegroundBrush}" />
                </DockPanel>
            </Border>

            <Grid Grid.Row="1" Margin="24">
                <ContentControl Content="{Binding CurrentPage}" />
                <Border Background="#88000000"
                        Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Scanning..."
                                   Foreground="White"
                                   FontSize="18"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
