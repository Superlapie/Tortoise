<UserControl x:Class="Tortoise.App.Views.OverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,24">
            <TextBlock Text="Overview" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="{Binding SummaryText}"
                       Margin="0,8,0,24"
                       Foreground="{DynamicResource MutedForegroundBrush}"
                       TextWrapping="Wrap" />

            <UniformGrid Columns="2" Margin="0,0,0,24">
                <Border Margin="0,0,12,12" Padding="16" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="Devices" Foreground="{DynamicResource MutedForegroundBrush}" />
                        <TextBlock Text="{Binding DeviceCount}" FontSize="28" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Margin="12,0,0,12" Padding="16" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="Problem devices" Foreground="{DynamicResource MutedForegroundBrush}" />
                        <TextBlock Text="{Binding ProblemCount}" FontSize="28" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Margin="0,0,12,0" Padding="16" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="Recommended updates" Foreground="{DynamicResource MutedForegroundBrush}" />
                        <TextBlock Text="{Binding RecommendedCount}" FontSize="28" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Margin="12,0,0,0" Padding="16" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="Optional / restricted" Foreground="{DynamicResource MutedForegroundBrush}" />
                        <TextBlock FontSize="28" FontWeight="SemiBold">
                            <Run Text="{Binding OptionalCount}" />
                            <Run Text="/" />
                            <Run Text="{Binding RestrictedCount}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock>
                <Run Text="Last scan:" />
                <Run Text="{Binding LastScanAtUtc, StringFormat={}{0:G}}" />
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>
