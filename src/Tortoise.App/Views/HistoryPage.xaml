<UserControl x:Class="Tortoise.App.Views.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock Text="History" FontSize="24" FontWeight="SemiBold" DockPanel.Dock="Top" Margin="0,0,0,16" />
        <ListBox ItemsSource="{Binding Items}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,4">
                        <TextBlock Text="{Binding TimestampUtc, StringFormat={}{0:G}}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource MutedForegroundBrush}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
