<UserControl x:Class="Tortoise.App.Views.DevicesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="Devices" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBox Width="260"
                     Margin="24,0,0,0"
                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Search devices" />
        </StackPanel>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Devices}"
                  SelectedItem="{Binding SelectedDevice}"
                  Margin="0,0,0,16">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Device" Binding="{Binding FriendlyName}" Width="2*" />
                <DataGridTextColumn Header="Class" Binding="{Binding ClassName}" Width="*" />
                <DataGridTextColumn Header="Manufacturer" Binding="{Binding Manufacturer}" Width="*" />
                <DataGridTextColumn Header="Driver" Binding="{Binding DriverSummary}" Width="*" />
                <DataGridTextColumn Header="Version" Binding="{Binding VersionSummary}" Width="*" />
                <DataGridTextColumn Header="Status" Binding="{Binding StatusSummary}" Width="*" />
                <DataGridTextColumn Header="Update" Binding="{Binding UpdateSummary}" Width="2*" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2"
                Padding="16"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                DataContext="{Binding SelectedDevice}">
            <StackPanel>
                <TextBlock Text="Device details" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock Text="{Binding InstanceId, StringFormat=Instance ID: {0}}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding HardwareIds, StringFormat=Hardware IDs: {0}}" Margin="0,8,0,0" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ProblemDetails, StringFormat=Health: {0}}" Margin="0,8,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
