<UserControl x:Class="Tortoise.App.Views.PilotPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Physical Pilot" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Review the checklist and record final confirmation before any physical install work. Confirmation does not install drivers."
                       Margin="0,8,0,16"
                       Foreground="{DynamicResource MutedForegroundBrush}"
                       TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <ComboBox ItemsSource="{Binding Plans}"
                          SelectedItem="{Binding SelectedPlan}"
                          DisplayMemberPath="DisplayName"
                          MinWidth="420"
                          Margin="0,0,12,0" />
                <Button Content="Refresh Plans"
                        Command="{Binding RefreshPlansCommand}"
                        Margin="0,0,8,0" />
                <Button Content="Evaluate Checklist"
                        Command="{Binding EvaluateChecklistCommand}" />
            </StackPanel>

            <TextBlock Text="{Binding ChecklistSummary}"
                       FontWeight="SemiBold"
                       Margin="0,0,0,12"
                       TextWrapping="Wrap" />

            <ItemsControl ItemsSource="{Binding ChecklistItems}" Margin="0,0,0,24">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                Padding="12"
                                Margin="0,0,0,8">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="{Binding Status}"
                                               DockPanel.Dock="Right"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                </DockPanel>
                                <TextBlock Text="{Binding Detail}"
                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Required acknowledgements" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
            <ItemsControl ItemsSource="{Binding Acknowledgements}" Margin="0,0,0,16">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding Title}"
                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                  Margin="0,0,0,8" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Confirmation phrase" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock Text="{Binding RequiredConfirmationPhrase, StringFormat=Type exactly: {0}}"
                       Foreground="{DynamicResource MutedForegroundBrush}"
                       Margin="0,0,0,8" />
            <TextBox Text="{Binding ConfirmationPhrase, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,12" />

            <Button Content="Confirm Physical Pilot Readiness"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{Binding ConfirmCommand}"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,16" />

            <TextBlock Text="{Binding LastConfirmationSummary}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,24" />

            <TextBlock Text="Recovery guide" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBox Text="{Binding RecoveryGuidePreview}"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     MinHeight="220"
                     VerticalScrollBarVisibility="Auto" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
